		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	},
	"dependencies": {
		"@reduxjs/toolkit": "^2.6.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
